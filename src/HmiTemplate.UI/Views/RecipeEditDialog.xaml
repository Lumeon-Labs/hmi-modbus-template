<Window x:Class="HmiTemplate.UI.Views.RecipeEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="編輯配方"
        Width="420" Height="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Border Margin="20">
        <StackPanel>

            <TextBlock Text="配方設定"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,16"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="36"/>
                </Grid.RowDefinitions>

                <!-- 配方名稱 -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="配方名稱" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBox Grid.Row="0" Grid.Column="1"
                         x:Name="TxtName"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"/>

                <!-- 溫度設定 -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="溫度設定值 (°C)" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding TemperatureSetpoint, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"/>

                <!-- 轉速設定 -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="轉速設定值 (RPM)" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBox Grid.Row="2" Grid.Column="1"
                         Text="{Binding SpeedSetpoint, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"/>

                <!-- 壓力上限 -->
                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="壓力上限 (kPa)" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBox Grid.Row="3" Grid.Column="1"
                         Text="{Binding PressureLimit, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"/>

                <!-- 說明 -->
                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="說明" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBox Grid.Row="4" Grid.Column="1"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"/>
            </Grid>

            <!-- 按鈕 -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="取消"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="80"
                        Click="OnCancelClick"
                        Margin="0,0,8,0"/>
                <Button Content="確定"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="80"
                        Click="OnOkClick"
                        IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

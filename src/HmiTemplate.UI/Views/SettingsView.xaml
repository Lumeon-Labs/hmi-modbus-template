<UserControl x:Class="HmiTemplate.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="700" HorizontalAlignment="Left">

            <!-- 頁面標題 -->
            <TextBlock Text="Settings"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,20"/>

            <!-- ══════════════════════════════════
                 連線設定
            ══════════════════════════════════ -->
            <Border Style="{StaticResource ValueCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="MODBUS 連線設定"
                               Style="{StaticResource CardTitleStyle}"
                               Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="IP 位址" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Port" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="讀取間隔" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  ItemsSource="{Binding ReadIntervalOptions}"
                                  SelectedItem="{Binding SelectedReadInterval}"
                                  Margin="0,0,0,16">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat={}{0} ms}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Row="3" Grid.Column="1"
                                Content="套用並重連"
                                Command="{Binding ApplyAndReconnectCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════
                 Slave 模擬器控制
            ══════════════════════════════════ -->
            <Border Style="{StaticResource ValueCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="SLAVE 模擬器"
                               Style="{StaticResource CardTitleStyle}"
                               Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="狀態："
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding SlaveStatusColor}"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding SlaveStatus}"
                                   Foreground="{Binding SlaveStatusColor}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Start Slave"
                                Command="{Binding StartSlaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="{Binding IsSlaveRunning,
                                    Converter={StaticResource InverseBoolConverter}}"
                                Margin="0,0,8,0"/>
                        <Button Content="Stop Slave"
                                Command="{Binding StopSlaveCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                IsEnabled="{Binding IsSlaveRunning}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════
                 系統資訊
            ══════════════════════════════════ -->
            <Border Style="{StaticResource ValueCardStyle}">
                <StackPanel>
                    <TextBlock Text="系統資訊"
                               Style="{StaticResource CardTitleStyle}"
                               Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="版本" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding AppVersion}"
                                   FontFamily="Consolas"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text=".NET" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding DotNetVersion}"
                                   FontFamily="Consolas"
                                   FontSize="11"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Build Date" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding BuildDate}"
                                   FontFamily="Consolas"/>

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="連線狀態" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="{Binding ConnectionStatus}"
                                   FontFamily="Consolas"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

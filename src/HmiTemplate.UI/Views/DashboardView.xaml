<UserControl x:Class="HmiTemplate.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">

            <!-- 頁面標題 -->
            <TextBlock Text="Dashboard" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,20"/>

            <!-- ══════════════════════════════════
                 數值卡片區（4 個橫排）
            ══════════════════════════════════ -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,20">

                <!-- 溫度卡 -->
                <Border Style="{StaticResource ValueCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="溫度" Style="{StaticResource CardTitleStyle}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Temperature, StringFormat={}{0:F1}}"
                                       Style="{StaticResource ValueTextStyle}"/>
                            <TextBlock Text="°C" Style="{StaticResource UnitTextStyle}"/>
                            <TextBlock Text="{Binding TempTrend}"
                                       FontSize="18"
                                       Foreground="{Binding TempTrendColor}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TemperatureSetpoint, StringFormat=SP: {0:F1}°C}"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 壓力卡 -->
                <Border Style="{StaticResource ValueCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="壓力" Style="{StaticResource CardTitleStyle}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Pressure, StringFormat={}{0:F1}}"
                                       Style="{StaticResource ValueTextStyle}"/>
                            <TextBlock Text="kPa" Style="{StaticResource UnitTextStyle}"/>
                            <TextBlock Text="{Binding PressureTrend}"
                                       FontSize="18"
                                       Foreground="{Binding PressureTrendColor}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PressureLimit, StringFormat=Limit: {0:F1} kPa}"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 轉速卡 -->
                <Border Style="{StaticResource ValueCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="轉速" Style="{StaticResource CardTitleStyle}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Speed, StringFormat={}{0:F0}}"
                                       Style="{StaticResource ValueTextStyle}"/>
                            <TextBlock Text="RPM" Style="{StaticResource UnitTextStyle}"/>
                            <TextBlock Text="{Binding SpeedTrend}"
                                       FontSize="18"
                                       Foreground="{Binding SpeedTrendColor}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SpeedSetpoint, StringFormat=SP: {0:F0} RPM}"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 流量卡 -->
                <Border Style="{StaticResource ValueCardStyle}">
                    <StackPanel>
                        <TextBlock Text="流量" Style="{StaticResource CardTitleStyle}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Flow, StringFormat={}{0:F1}}"
                                       Style="{StaticResource ValueTextStyle}"/>
                            <TextBlock Text="L/min" Style="{StaticResource UnitTextStyle}"/>
                            <TextBlock Text="{Binding FlowTrend}"
                                       FontSize="18"
                                       Foreground="{Binding FlowTrendColor}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="流量計量" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ══════════════════════════════════
                 LED 狀態列
            ══════════════════════════════════ -->
            <Border Style="{StaticResource ValueCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="設備狀態" Style="{StaticResource CardTitleStyle}"
                               Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">

                        <!-- 運轉中 LED -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                            <Ellipse Style="{StaticResource LedStyle}"
                                     Margin="0,0,8,0">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding IsRunning,
                                        Converter={StaticResource BoolToColorConverter},
                                        ConverterParameter=running}"/>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect
                                        Color="#22C55E" BlurRadius="8"
                                        ShadowDepth="0" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="運轉中" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 警報 LED（Active 時透過 Storyboard 讓 Glow 閃爍） -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                            <Ellipse Width="16" Height="16"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"
                                     x:Name="AlarmLed">
                                <Ellipse.Fill>
                                    <SolidColorBrush
                                        Color="{Binding HasAlarm,
                                            Converter={StaticResource BoolToColorConverter},
                                            ConverterParameter=alarm}"/>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect
                                        x:Name="AlarmGlow"
                                        Color="#EF4444" BlurRadius="0"
                                        ShadowDepth="0" Opacity="0.8"/>
                                </Ellipse.Effect>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard x:Name="AlarmBlinkStoryboard">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation
                                                    Storyboard.TargetName="AlarmGlow"
                                                    Storyboard.TargetProperty="BlurRadius"
                                                    From="0" To="16"
                                                    Duration="0:0:0.6"
                                                    AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="警報" VerticalAlignment="Center"
                                       Foreground="{Binding HasAlarm,
                                           Converter={StaticResource BoolToBrushConverter},
                                           ConverterParameter=alarm}"/>
                        </StackPanel>

                        <!-- 急停 LED -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                            <Ellipse Style="{StaticResource LedStyle}"
                                     Margin="0,0,8,0">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding IsEmergencyStop,
                                        Converter={StaticResource BoolToColorConverter},
                                        ConverterParameter=estop}"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="急停" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 加熱中 LED -->
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource LedStyle}"
                                     Margin="0,0,8,0">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding IsHeating,
                                        Converter={StaticResource BoolToColorConverter},
                                        ConverterParameter=heating}"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="加熱中" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════
                 系統資訊
            ══════════════════════════════════ -->
            <Border Style="{StaticResource ValueCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="系統時間" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="{Binding SystemTime}"
                                   FontFamily="Consolas" FontSize="18"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="累計運轉" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="{Binding UptimeDisplay}"
                                   FontFamily="Consolas" FontSize="18"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════
         色彩定義 - 深色工業 HMI 主題
    ══════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="BackgroundBrush"  Color="#0A0E1A"/>
    <SolidColorBrush x:Key="CardBrush"        Color="#111827"/>
    <SolidColorBrush x:Key="SidebarBrush"     Color="#0D1424"/>
    <SolidColorBrush x:Key="PrimaryBrush"     Color="#4A9EFF"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#2DD4BF"/>
    <SolidColorBrush x:Key="TextBrush"        Color="#E2E8F0"/>
    <SolidColorBrush x:Key="MutedBrush"       Color="#6B7280"/>
    <SolidColorBrush x:Key="DangerBrush"      Color="#EF4444"/>
    <SolidColorBrush x:Key="SuccessBrush"     Color="#22C55E"/>
    <SolidColorBrush x:Key="WarningBrush"     Color="#F59E0B"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#1E293B"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#1E2D45"/>

    <!-- Sidebar 選中狀態（Primary 20% 透明度） -->
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="#334A9EFF"/>

    <!-- ══════════════════════════════════════════════
         LED 指示燈樣式
    ══════════════════════════════════════════════ -->
    <Style x:Key="LedStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 綠色 LED（運轉中） -->
    <RadialGradientBrush x:Key="GreenLedBrush">
        <GradientStop Color="#88FFAA" Offset="0"/>
        <GradientStop Color="#22C55E" Offset="0.5"/>
        <GradientStop Color="#15803D" Offset="1"/>
    </RadialGradientBrush>

    <!-- 紅色 LED（警報/急停） -->
    <RadialGradientBrush x:Key="RedLedBrush">
        <GradientStop Color="#FFAAAA" Offset="0"/>
        <GradientStop Color="#EF4444" Offset="0.5"/>
        <GradientStop Color="#991B1B" Offset="1"/>
    </RadialGradientBrush>

    <!-- 琥珀色 LED（加熱中） -->
    <RadialGradientBrush x:Key="AmberLedBrush">
        <GradientStop Color="#FFE0AA" Offset="0"/>
        <GradientStop Color="#F59E0B" Offset="0.5"/>
        <GradientStop Color="#B45309" Offset="1"/>
    </RadialGradientBrush>

    <!-- 灰色 LED（停用） -->
    <RadialGradientBrush x:Key="GrayLedBrush">
        <GradientStop Color="#6B7280" Offset="0"/>
        <GradientStop Color="#374151" Offset="1"/>
    </RadialGradientBrush>

    <!-- ══════════════════════════════════════════════
         數值卡片（ValueCard）
    ══════════════════════════════════════════════ -->
    <Style x:Key="ValueCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ══════════════════════════════════════════════
         大數值文字（Consolas 36px 亮藍）
    ══════════════════════════════════════════════ -->
    <Style x:Key="ValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
    </Style>

    <!-- 單位小字 -->
    <Style x:Key="UnitTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="4,0,0,5"/>
    </Style>

    <!-- 卡片標題 -->
    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- ══════════════════════════════════════════════
         一般文字
    ══════════════════════════════════════════════ -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- ══════════════════════════════════════════════
         Sidebar 導覽按鈕
    ══════════════════════════════════════════════ -->
    <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Margin="6,2">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center"
                            Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{StaticResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar 選中狀態 -->
    <Style x:Key="NavButtonActiveStyle" TargetType="Button"
           BasedOn="{StaticResource NavButtonStyle}">
        <Setter Property="Background" Value="{StaticResource SidebarActiveBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
    </Style>

    <!-- ══════════════════════════════════════════════
         主要動作按鈕
    ══════════════════════════════════════════════ -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#5EAEFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#3A8EEF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="#374151"/>
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次要按鈕（邊框樣式） -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button"
           BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 危險按鈕（紅色） -->
    <Style x:Key="DangerButtonStyle" TargetType="Button"
           BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
    </Style>

    <!-- ══════════════════════════════════════════════
         TextBox（輸入框）
    ══════════════════════════════════════════════ -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#1E293B"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
    </Style>

    <!-- ══════════════════════════════════════════════
         ComboBox（下拉選單）
    ══════════════════════════════════════════════ -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="#1E293B"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <!-- ══════════════════════════════════════════════
         DataGrid
    ══════════════════════════════════════════════ -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="#151F2E"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#0D1424"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════
         TabControl
    ══════════════════════════════════════════════ -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="bd" Padding="{TemplateBinding Padding}"
                            BorderThickness="0,0,0,2"
                            BorderBrush="Transparent">
                        <ContentPresenter ContentSource="Header"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush"
                                    Value="{StaticResource PrimaryBrush}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground"
                                    Value="{StaticResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════
         ScrollBar（深色滾動條）
    ══════════════════════════════════════════════ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="6"/>
    </Style>

    <!-- ══════════════════════════════════════════════
         Label
    ══════════════════════════════════════════════ -->
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- ══════════════════════════════════════════════
         分隔線
    ══════════════════════════════════════════════ -->
    <Style x:Key="SeparatorStyle" TargetType="Rectangle">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Fill" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Margin" Value="0,8"/>
    </Style>

</ResourceDictionary>

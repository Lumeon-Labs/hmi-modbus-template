<Window x:Class="HmiTemplate.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HmiTemplate.UI.ViewModels"
        xmlns:views="clr-namespace:HmiTemplate.UI.Views"
        mc:Ignorable="d"
        Title="HMI Template - 工業監控系統"
        Width="1280" Height="760"
        MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- DataTemplate：ViewModel → View 自動對應 -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TrendViewModel}">
            <views:TrendView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecipeViewModel}">
            <views:RecipeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlarmViewModel}">
            <views:AlarmView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 頂部標題列 -->
        <Border Grid.Row="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + 標題 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28"
                            Background="{StaticResource PrimaryBrush}"
                            CornerRadius="4"
                            Margin="0,0,10,0">
                        <TextBlock Text="HM" FontSize="10" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="HMI Template"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  |  工業監控系統"
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 連線狀態 -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding ConnectionStatusColor}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionStatusText}"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Modbus TCP"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主體：Sidebar + 內容區 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom"
                               Text="客製：mars-industrial.pages.dev"
                               FontSize="10"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="16,0,0,12"/>
                    <TextBlock DockPanel.Dock="Bottom"
                               Text="v1.0.0 · Built by Mars"
                               FontSize="10"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="16,0,0,2"/>

                    <StackPanel Margin="8,12">
                        <TextBlock Text="NAVIGATION"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="12,0,0,8"/>

                        <!-- Dashboard -->
                        <Button x:Name="BtnDashboard"
                                Command="{Binding NavigateToDashboardCommand}"
                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⬡ " FontSize="14"/>
                                <TextBlock Text="Dashboard"/>
                            </StackPanel>
                        </Button>

                        <!-- Trend -->
                        <Button x:Name="BtnTrend"
                                Command="{Binding NavigateToTrendCommand}"
                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📈 " FontSize="14"/>
                                <TextBlock Text="Trend"/>
                            </StackPanel>
                        </Button>

                        <!-- Recipe -->
                        <Button x:Name="BtnRecipe"
                                Command="{Binding NavigateToRecipeCommand}"
                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋 " FontSize="14"/>
                                <TextBlock Text="Recipe"/>
                            </StackPanel>
                        </Button>

                        <!-- Alarm -->
                        <Button x:Name="BtnAlarm"
                                Command="{Binding NavigateToAlarmCommand}"
                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔔 " FontSize="14"/>
                                <TextBlock Text="Alarm"/>
                            </StackPanel>
                        </Button>

                        <!-- Settings -->
                        <Button x:Name="BtnSettings"
                                Command="{Binding NavigateToSettingsCommand}"
                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙ " FontSize="14"/>
                                <TextBlock Text="Settings"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 內容區：自動根據 CurrentView 的型別套用 DataTemplate -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentView}"
                            Background="{StaticResource BackgroundBrush}"/>
        </Grid>
    </Grid>
</Window>
